# ==================================
# DATABASE
# ==================================
DATABASE_URL="postgresql://pump:Djyb1234@pump-db-server.postgres.database.azure.com:5432/postgres?sslmode=require"

# ==================================
# SERVER CONFIGURATION
# ==================================
PORT=5000
JWT_SECRET="super_secret_jwt_key_change_this"

# ==================================
# URLS (Important for OAuth and Redirects)
# ==================================
# For local development:
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# For production/ngrok, update these to your actual URLs, e.g.:
# CLIENT_URL=https://your-frontend.com
# SERVER_URL=https://your-backend.com

# ==================================
# GOOGLE OAUTH
# ==================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# IMPORTANT: Update the Google Cloud Console Authorized redirect URIs to match SERVER_URL:
# Add this URL to Google Console: http://localhost:5000/api/auth/google/callback
# Or for production: https://your-backend.com/api/auth/google/callback

# ==================================
# EMAIL CONFIGURATION (Optional)
# ==================================
# Uncomment and configure these to enable email-based password reset
# For Gmail, you need to create an App Password:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a new App Password for "Mail"
# 4. Use that password below

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your.email@gmail.com
# EMAIL_PASSWORD=your_16_char_app_password_here

# If email is not configured, password reset tokens will be printed to the console
